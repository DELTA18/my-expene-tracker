rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/expenses/{expenseId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/meta/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Legacy shared data from before sign-in existed. Kept temporarily so each
    // account's data can be copied into its own space on first login, then
    // deleted client-side. No new writes go here. Safe to delete this whole
    // block once you've confirmed migration ran (both legacy collections empty).
    match /expenses/{expenseId} {
      allow read, delete: if request.auth != null;
      allow write: if false;
    }
    match /meta/{docId} {
      allow read, delete: if request.auth != null;
      allow write: if false;
    }
  }
}
