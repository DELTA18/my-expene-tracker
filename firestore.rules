rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A personal expense is just the one-participant case of a shared one.
    // `payer` (who physically paid) can differ from `createdBy` (whoever is
    // logging it in their own app right now) — either participant can log a
    // shared expense on the other's behalf. Only whoever created it can
    // change or remove it, since it affects the other participant's balance.
    match /expenses/{expenseId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }

    // Canonical, live display identity (name + optional photo), resolved by
    // uid wherever one already appears (an expense's participants, a
    // settlement's from/to, or a directory lookup). Gettable by anyone
    // signed in who already has the uid; never listable.
    match /profiles/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Email -> uid pointer so you can find someone to split with. Gettable
    // by exact email only (no enumeration); writable only by that email's
    // own owner.
    match /directory/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null
        && request.auth.token.email == email
        && request.resource.data.uid == request.auth.uid;
    }

    // Money changing hands outside the app, netted against a balance —
    // not a spend, so it never touches /expenses.
    match /settlements/{settlementId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && (request.auth.uid == request.resource.data.from
            || request.auth.uid == request.resource.data.to);
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }

    match /users/{uid}/meta/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
